# OpenAI API key used server-side to read the uploaded 화면설계서 (rasterized
# to page images) and extract test scenarios. Get one at
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: override the model used for extraction (defaults to a current
# GPT-4o vision-capable model).
# OPENAI_MODEL=gpt-4o

# Supabase project used for history (metadata) + file storage.
# Project URL: https://<project-ref>.supabase.co
SUPABASE_URL=
# Prefer the service_role key (Project Settings > API) for reliability.
# The anon/publishable key also works because this app's RLS policies are
# intentionally permissive (personal, single-user tool, no end-user auth).
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=

# Browser-exposed copies used to upload the PDF directly to Supabase
# Storage from the client (bypasses Vercel's 4.5MB serverless request body
# limit). Safe to expose: this app's RLS policies are intentionally
# permissive, and the actual upload is authorized by a short-lived signed
# URL token minted server-side, not by this key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
